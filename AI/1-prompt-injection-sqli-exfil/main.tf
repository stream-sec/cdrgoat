            os.remove(os.path.join(MSG_DIR, f"{msg_id}.json"))
            os.remove(resp_path)
            return jsonify({"response": resp["content"]})
        time.sleep(0.5)

    return jsonify({"error": "agent timeout"}), 504

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=80)
